# =============================================================================
# Agent Sean — hosted control plane (apps/cloud)
# =============================================================================
# Copy to `.env.local` and fill in what you need. EVERY variable is optional:
# the app builds and boots with an empty file. Each unconfigured integration
# renders a clearly-labelled "not configured" banner instead of crashing.
#
# Never commit `.env.local` (it is gitignored). Only this template is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (auth + database)
# -----------------------------------------------------------------------------
# Project URL and keys from: Supabase dashboard → Project Settings → API.
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser. Used for
# admin reads/writes that must bypass Row Level Security (KPIs, impersonation).
# Settings → API → service_role secret. Keep this out of the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Roles
# -----------------------------------------------------------------------------
# Comma-separated emails granted `superadmin` on first login. Thereafter the
# role is stored on the profiles row; this list only bootstraps the operator.
SUPERADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# Master key used to encrypt provider credentials saved via /admin/billing,
# using AES-256-GCM (envelope pattern from packages/hosted/src/envelope.ts).
# Generate: `openssl rand -hex 32` (64 hex chars) or `openssl rand -base64 32`.
# Without it, /admin/billing refuses to persist secrets (read-only) rather than
# storing them in plaintext.
ADMIN_SECRET_KEY=

# -----------------------------------------------------------------------------
# Billing provider selection
# -----------------------------------------------------------------------------
# Which adapter backs checkout/webhooks: `polar` (default) or `paddle`.
BILLING_PROVIDER=polar

# --- Polar.sh (PRIMARY) ------------------------------------------------------
# Organization Access Token (starts `polar_oat_...`) from:
# Polar dashboard → Settings → Developers → Organization Access Tokens.
POLAR_ACCESS_TOKEN=
# Endpoint secret for verifying Standard Webhooks signatures:
# Polar dashboard → Settings → Webhooks → your endpoint → Secret.
POLAR_WEBHOOK_SECRET=
# Use the sandbox API (https://sandbox-api.polar.sh). `true` for testing.
POLAR_SANDBOX=true
# Optional: your Polar organization id (for listing/scoping).
POLAR_ORGANIZATION_ID=
# Optional JSON map of plan id -> Polar product/price id, e.g.
# {"cloud_starter":"prod_...","cloud_pro":"prod_..."}. Can also be set per-plan
# in /admin/billing. Leave blank if you configure products in the admin UI.
POLAR_PRODUCTS_JSON=

# --- Paddle Billing (FALLBACK) ----------------------------------------------
# API key (starts `pdl_live_apikey_...` or `pdl_sdbx_apikey_...`):
# Paddle dashboard → Developer Tools → Authentication.
PADDLE_API_KEY=
# Webhook signing secret (starts `pdl_ntfset_...`):
# Paddle dashboard → Developer Tools → Notifications → your destination.
PADDLE_WEBHOOK_SECRET=
# Use the sandbox API (https://sandbox-api.paddle.com). `true` for testing.
PADDLE_SANDBOX=true
# Optional JSON map of plan id -> Paddle price id, e.g.
# {"cloud_starter":"pri_...","cloud_pro":"pri_..."}.
PADDLE_PRICES_JSON=

# -----------------------------------------------------------------------------
# Email (optional, pluggable)
# -----------------------------------------------------------------------------
# Used to email payment-link invites from /admin/invites. If unset, invite
# emails are logged with a warning and NOT sent (the app never hard-fails).
# Resend API key (starts `re_...`): https://resend.com/api-keys
RESEND_API_KEY=
# From address for outbound mail, e.g. "Agent Sean <billing@yourdomain.com>".
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Terminal relay
# -----------------------------------------------------------------------------
# External WebSocket relay the self-hosted daemon dials OUT to. If unset, the
# terminal falls back to SSE-for-output + POST-for-input handled in-process.
# See src/lib/terminal/protocol.ts and the README "terminal relay" section.
TERMINAL_RELAY_URL=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin of this deployment, e.g. https://app.agentsean.com. Used to
# build absolute success_url / webhook URLs. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
