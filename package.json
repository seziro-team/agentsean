{
  "name": "sean",
  "private": true,
  "version": "0.0.0",
  "description": "Agent Sean — the self-hosted autonomous SEO engineer",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --workspace-concurrency=1 build",
    "test": "vitest run",
    "typecheck": "pnpm -r --sort --workspace-concurrency=1 typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sean": "pnpm --filter agentsean start",
    "ci": "pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.3",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@napi-rs/keyring",
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": ["playwright"]
    }
  }
}
