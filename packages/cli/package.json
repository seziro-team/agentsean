  "license": "AGPL-3.0-only",
  "description": "Agent Sean — the self-hosted autonomous SEO engineer",
  "type": "module",
  "bin": {
    "agentsean": "./dist/bin.js",
    "sean": "./dist/bin.js"
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vp2722/sean.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
