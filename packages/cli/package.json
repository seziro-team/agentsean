    "test": "vitest run --config ../../vitest.config.ts",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@agentsean/actions": "workspace:*",
    "@agentsean/adapter-git": "workspace:*",
    "@agentsean/analyzers": "workspace:*",
    "@agentsean/crawler": "workspace:*",
    "@agentsean/daemon": "workspace:*",
    "@agentsean/db": "workspace:*",
    "@agentsean/google": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
