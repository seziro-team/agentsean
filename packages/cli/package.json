{
  "name": "agentsean",
  "version": "1.0.1",
  "license": "AGPL-3.0-only",
  "description": "Agent Sean — the self-hosted autonomous SEO engineer",
  "type": "module",
  "bin": {
    "agentsean": "./dist/bin.js",
    "sean": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seziro-team/agentsean.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@agentsean/actions": "workspace:*",
    "@agentsean/adapter-git": "workspace:*",
    "@agentsean/adapter-factory": "workspace:*",
    "@agentsean/analyzers": "workspace:*",
    "@agentsean/content": "workspace:*",
    "@agentsean/credentials": "workspace:*",
    "@agentsean/crawler": "workspace:*",
    "@agentsean/daemon": "workspace:*",
    "@agentsean/llm": "workspace:*",
    "@agentsean/db": "workspace:*",
    "@agentsean/google": "workspace:*",
    "@agentsean/keywords": "workspace:*",
    "@agentsean/measure": "workspace:*",
    "@agentsean/surfaces": "workspace:*",
    "@agentsean/hosted": "workspace:*",
    "@agentsean/launch": "workspace:*",
    "@agentsean/mcp": "workspace:*",
    "@agentsean/providers": "workspace:*",
    "@agentsean/scheduler": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/seziro-team/agentsean#readme",
  "bugs": {
    "url": "https://github.com/seziro-team/agentsean/issues"
  },
  "author": "Seziro (https://seziro.com)",
  "keywords": [
    "seo",
    "agent",
    "agentsean",
    "seo-automation"
  ]
}
