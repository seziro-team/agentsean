    "test": "vitest run --config ../../vitest.config.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@agentsean/crawler": "workspace:*",
    "@agentsean/db": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
